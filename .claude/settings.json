{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./tools/oracle/.venv/**)",
      "Grep(./tools/oracle/.venv/**)"
    ],
    "ask": [
      "Bash(npm publish*)",
      "Bash(pnpm publish*)"
    ],
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm build*)",
      "Bash(pnpm install*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx tsup*)",
      "Bash(npx tsx tools/emulator-serve.ts*)",
      "Bash(node .claude/skills/release-drill/scripts/drill.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue list*)"
    ]
  }
}
